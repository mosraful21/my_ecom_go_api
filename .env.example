APP_NAME=my_ecom_api
APP_ENV=development
APP_PORT=4000

DB_NAME=my_ecom_go
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

COOKIE_NAME=my_shop_session
STORAGE_PATH=./storage
PAGINATION_LIMIT=50

SMS_ENABLED=false
SMS_API_KEY=
SMS_API_URL=

RECOVERY_SECRET=
RECOVERY_COOKIE_SECURE=true

# Used only by `go run ./cmd/bootstrap-admin`; never commit real values.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=